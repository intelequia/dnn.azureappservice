<dotnetnuke type="Package" version="5.0">
  <packages>
    <package name="AzureAppServiceAdapter" type="Library" version="01.00.03">
      <friendlyName>DNN Azure App Service adapter</friendlyName>
      <description>
        The DNN Azure App Service adapter is an adapter for DNN Platform to adapt scheduled tasks and other DNN utilities to Azure App Service.
      </description>
      <iconFile>~/DesktopModules/AzureAppService/Images/AppService.png</iconFile>
      <owner>
        <name>Intelequia</name>
        <organization>Intelequia Software Solutions</organization>
        <url>http://intelequia.com</url>
        <email>info@intelequia.com</email>
      </owner>
      <license src="AzureAppServiceLicense.txt" />
      <releaseNotes src="AzureAppServiceReleaseNotes.txt"/>
      <azureCompatible>true</azureCompatible>
      <dependencies>
        <dependency type="CoreVersion">09.03.00</dependency>
      </dependencies>

      <components>
        <component type="ResourceFile">
          <resourceFiles>
            <basePath>DesktopModules/AzureAppService</basePath>
            <resourceFile>
              <name>Resources.zip</name>
            </resourceFile>
          </resourceFiles>
        </component>

        <component type="Config">
          <config>
            <configFile>web.config</configFile>
            <install>
              <configuration>
                <nodes>
                  <node path="/configuration/dotnetnuke/caching/providers" action="update" key="name" collision="overwrite">
                    <add name="ServiceBusCachingProvider"
                         type="DotNetNuke.Azure.AppService.Providers.CachingProviders.ServiceBusCachingProvider, DotNetNuke.Azure.AppService"
                         providerPath="~\Providers\CachingProviders\ServiceBusCachingProvider\" serviceBusPoolSize="20" topicName="dnntopic" />
                  </node>
                  <node path="/configuration/connectionStrings" action="update" key="name" collision="ignore">
                    <add name="ServiceBusCachingProvider" connectionString="" providerName="DotNetNuke.Providers.ServiceBusCachingProvider" />
                  </node>
                  <!-- Binding redirect for Azure.Core: explicit update because AssemblyInstaller
                       only updates redirects when returnCode < 2 (i.e., when it actually copies the DLL).
                       If Azure.Core is already registered at 1.38.0 in dbo.Assemblies from a prior install,
                       returnCode == 2 and the redirect is never updated, leaving the old 1.18 version. -->
                  <node path="/configuration/runtime/ab:assemblyBinding"
                        action="update"
                        collision="overwrite"
                        targetpath="/configuration/runtime/ab:assemblyBinding/ab:dependentAssembly[ab:assemblyIdentity/@name='Azure.Core'][ab:assemblyIdentity/@publicKeyToken='92742159e12e44c8']"
                        nameSpace="urn:schemas-microsoft-com:asm.v1"
                        nameSpacePrefix="ab">
                    <dependentAssembly xmlns="urn:schemas-microsoft-com:asm.v1">
                      <assemblyIdentity name="Azure.Core" publicKeyToken="92742159e12e44c8" />
                      <bindingRedirect oldVersion="0.0.0.0-32767.32767.32767.32767" newVersion="1.38.0.0" />
                    </dependentAssembly>
                  </node>
                </nodes>
              </configuration>
            </install>
            <uninstall>
              <configuration>
                <nodes>
                  <node path="/configuration/dotnetnuke/caching/providers/add[@name='ServiceBusCachingProvider']" action="remove" />
                  <node path="/configuration/connectionStrings/add[@name='ServiceBusCachingProvider']" action="remove" />
                </nodes>
              </configuration>
            </uninstall>
          </config>
        </component>

        <!-- Database scripts -->
        <component type="Script">
          <scripts>
            <basePath>DesktopModules/AzureAppService</basePath>
            <script type="Install">
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>01.00.00.SqlDataProvider</name>
              <version>01.00.00</version>
            </script>

            <script type="UnInstall" >
              <path>Providers\DataProviders\SqlDataProvider</path>
              <name>uninstall.SqlDataProvider</name>
              <version>01.00.00</version>
            </script>
          </scripts>
        </component>

        <component type="Assembly">
          <assemblies>
            <assembly>
              <path>bin</path>
              <name>DotNetNuke.Azure.AppService.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>Azure.Core.dll</name>
              <version>1.38.0</version>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>Azure.Core.Amqp.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>Azure.Messaging.ServiceBus.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>Microsoft.Azure.Amqp.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>Microsoft.Bcl.AsyncInterfaces.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>System.ClientModel.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>System.Diagnostics.DiagnosticSource.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>System.Memory.Data.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>System.Runtime.CompilerServices.Unsafe.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>System.Text.Encodings.Web.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>System.Text.Json.dll</name>
            </assembly>
            <assembly>
              <path>bin</path>
              <name>System.Threading.Tasks.Extensions.dll</name>
            </assembly>
          </assemblies>
        </component>

      </components>
    </package>
  </packages>
</dotnetnuke>
